# Banco
DATABASE_URL=postgresql+asyncpg://postgres:secret@db:5432/geoportal

# Redis
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60

# JWT
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-longa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (separado por vírgula)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# App
MAX_FEATURES_LIMIT=5000
DEFAULT_FEATURES_LIMIT=500
ENV=development